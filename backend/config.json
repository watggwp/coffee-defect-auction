{
  "http_port": 8000,
  "db_file": "auction.db",

  "mqtt": {
    "_comment": "detector_config = อ่าน host/port/username/password/topic จาก config.yaml ของตัวตรวจ (ตั้งค่าที่เดียว) | ใส่ null แล้วใช้ค่าด้านล่างแทน",
